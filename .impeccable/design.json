  "narrative": {
    "northStar": "مركز القيادة الهادئ",
    "overview": "واجهة عربية RTL فاخرة بضبط النفس، تقدّم الإجراء اليومي قبل الأرقام. تعتمد التباين الواضح، المساحات الهادئة، والذهبي كإشارة محدودة لا كلون نص أساسي. يمتد هذا النظام إلى مساحة الإدارة والنماذج الأصلية: حقول فاتحة بحدود واضحة، أقسام منظمة، وتنقل مستمر داخل نموذج الحجز الواحد.",
    "keyCharacteristics": [
      "Mobile First مع ترتيب تشغيلي ثابت على الهاتف.",
      "بطاقة بيضاء واحدة لكل قرار أو مجموعة إجراءات مترابطة.",
      "أخضر عميق للأفعال الأساسية، وذهبي محدود للحالة والزخرفة.",
      "لا تكرار للمعلومة أو زر الإجراء نفسه في الرئيسية."
    ],
    "rules": [
      {
        "name": "The One Identity Rule",
        "body": "لا تُدخل البنفسجي أو طبقة ألوان منافسة؛ تستخدم الواجهة الأدوار اللونية المعرّفة في التوكنز فقط.",
        "section": "colors"
      },
      {
        "name": "The Accessible Gold Rule",
        "body": "الذهبي الزخرفي مخصص للنقاط والحدود؛ النص الذهبي يستخدم درجة `gold-text` الأغمق.",
        "section": "colors"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "كل سطح ساكن؛ الظل يساعد على الفصل ولا ينافس المحتوى.",
        "section": "elevation"
      },
      "Secondary operational screens: compact wrapping calendar filters, 44px green header tools, and protection cards in three desktop columns and one mobile column."
    ],
    "dos": [
      "**Do** رتّب العمل اليومي قبل مؤشرات الأداء.",
      "**Do** اعرض حالة قديمة بصيغة تحتاج تأكيدًا مع وقت آخر تحديث.",
      "**Do** استخدم SVG دلاليًا وأهداف لمس لا تقل عن 44px."
    ],
    "donts": [
      "**Don't** تكرر الحجز القادم أو زر إضافة الحجز في الرئيسية.",
      "**Don't** تعيد النسخ الاحتياطي أو التحليلات الطويلة أو أفضل العملاء إلى الرئيسية.",
      "**Don't** تخفِ لوحة اليوم على الشاشات الصغيرة."
    ]
  }
